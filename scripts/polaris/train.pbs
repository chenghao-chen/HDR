#!/bin/bash -l
#PBS -N hdr_train
#PBS -A lighthouse-purdue
#PBS -q preemptable
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=08:00:00
#PBS -l filesystems=home:eagle
#PBS -r y
#PBS -o logs/
#PBS -e logs/

# ============================================================================
# Training on Polaris — 1 node, 1 A100 40 GB.
#
#   qsub scripts/polaris/train.pbs
#   qsub -v HDR_SAVE_FOLDER=models_p1_moe_run2/ scripts/polaris/train.pbs
#
# Queue choice is forced, not preferred: Polaris' prod and small queues both
# require >= 10 nodes, so a single-node job can only use debug (<= 1 h),
# debug-scaling (<= 1 h), or preemptable (<= 72 h). An 8-hour training run
# therefore has to be preemptable.
#
# Which makes the next two lines load-bearing:
#
#   #PBS -r y          preemptable jobs can be killed mid-run. This marks the
#                      job rerunnable so PBS requeues it automatically.
#   HDR_SAVE_FOLDER    pinned below, NOT timestamped. The training script
#                      resumes from <folder>/latest.pth; a fresh timestamp on
#                      each attempt would silently restart from epoch 0 and
#                      the job would never finish.
#
# Aurora's prod queue accepts single-node jobs, so scripts/aurora/train.pbs
# needs none of this.
# ============================================================================

set -uo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}" || exit 1

source "${PBS_O_WORKDIR:-$(pwd)}/scripts/lib/hdr_env.sh"
hdr::init

# Pinned run directory — see the note above about requeues.
export HDR_SAVE_FOLDER="${HDR_SAVE_FOLDER:-models_p1_moe_Teacher_MobileHDR_polaris01/}"

hdr::banner

if [[ -f "$HDR_SAVE_FOLDER/latest.pth" ]]; then
    hdr::log "Found $HDR_SAVE_FOLDER/latest.pth -> training will RESUME."
else
    hdr::log "No checkpoint in $HDR_SAVE_FOLDER -> training starts from scratch."
fi

hdr::preflight || hdr::die "environment is not usable; not starting an 8-hour run"

# Single-GPU: the other three A100s on this node sit idle. Using them would
# need DDP, which is a code change rather than a flag.
hdr::run "$HDR_PYTHON" train_A100_MoE_two_phase.py
status=$?

# ── Phase 2 memory warning ──────────────────────────────────────────────────
# The training script notes "batch_sz=1 is the limit for full frames on
# A100-80 GB". Polaris A100s have 40 GB, so PHASE=2 will very likely OOM here
# even at batch_sz=1. Phase 1 (512x512 patches, batch 8) is the one expected
# to fit. If you need Phase 2: gradient checkpointing, tiled fine-tuning, or
# run it on Aurora, whose Max 1550 tiles have 64 GB each.

exit $status
