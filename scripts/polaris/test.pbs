#!/bin/bash -l
#PBS -N hdr_test
#PBS -A lighthouse-purdue
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:eagle
#PBS -o logs/
#PBS -e logs/

# ============================================================================
# Evaluation on Polaris.
#
#   qsub scripts/polaris/test.pbs
#   qsub -v HDR_CHECKPOINT=models_.../phase1_best.pth scripts/polaris/test.pbs
#
# The debug queue (<= 2 nodes, <= 1 h) turns around far faster than
# preemptable, and evaluation is short enough to fit comfortably.
# ============================================================================

set -uo pipefail
cd "${PBS_O_WORKDIR:-$(pwd)}" || exit 1

source "${PBS_O_WORKDIR:-$(pwd)}/scripts/lib/hdr_env.sh"
hdr::init

export HDR_CHECKPOINT="${HDR_CHECKPOINT:-models_p1_moe_Teacher_MobileHDR_polaris01/phase1_best.pth}"

hdr::banner

# Fail before loading the model rather than after: the eval script otherwise
# spends a minute building the architecture and then dies on a missing file.
if [[ ! -f "$HDR_CHECKPOINT" ]]; then
    hdr::log "FATAL: checkpoint not found: $HDR_CHECKPOINT"
    hdr::log "Available checkpoints:"
    ls -1 models_*/*.pth 2>/dev/null || hdr::log "  (none — train first)"
    exit 1
fi

hdr::preflight || hdr::warn "continuing despite check failures"

hdr::run "$HDR_PYTHON" test_dual_MoE_two_phase.py
bench_status=$?

# Stage 2: the figures. Separate from the benchmark above because this is
# what you actually look at — per-frame noisy/predicted/reference over each
# expert's own output, plus the routing map. A mixture can post a fine
# blended PSNR while both experts have converged to the same function, and
# only the per-expert panels show that.
hdr::log ""
hdr::log "################ 2. Per-frame visuals ################################"
hdr::run "$HDR_PYTHON" scripts/save_test_outputs.py
visuals_status=$?

hdr::log ""
hdr::log "benchmark exit : $bench_status"
hdr::log "visuals   exit : $visuals_status"

(( bench_status == 0 && visuals_status == 0 )) || exit 1
exit 0
